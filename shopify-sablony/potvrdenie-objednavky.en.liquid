<!--
  Shopify e-mail "Order confirmation" — ANGLICKÁ verzia (zdrojový jazyk obchodu; slovenská verzia je potvrdenie-objednavky.liquid a vkladá sa ako preklad "Slovak" v Translate & Adapt).
  Settings -> Notifications -> Customer notifications -> Order confirmation -> Edit code.
  SUBJECT (Email subject):
    {% if customer.first_name != blank %}{{ customer.first_name }}, your order is placed!{% else %}Your order is placed!{% endif %} – order {{ order_name }}

  Transactional e-mail — no unsubscribe link on purpose (that belongs only in newsletters).
-->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Order confirmation {{ order_name }}</title>
  <style>body,table,td,p,h1,div,span,a{font-family:Arial,Helvetica,sans-serif !important;}</style>
</head>
<body style="margin:0;padding:0;background:#f3f4f6;font-family:Arial,Helvetica,sans-serif;color:#111827;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3f4f6;">
    <tr>
      <td align="center" style="padding:24px 12px;">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:100%;max-width:600px;background:#ffffff;">

          <!-- Header -->
          <tr>
            <td style="background:#232832;padding:22px 28px;">
              <a href="{{ shop.url }}"><img src="https://cdn.shopify.com/s/files/1/0777/1016/4311/files/logo-pbt.png?v=1791199171" alt="{{ shop.name }}" height="48" style="display:block;border:0;height:48px;max-width:240px;"></a>
            </td>
          </tr>

          <!-- Intro -->
          <tr>
            <td style="padding:28px 28px 8px 28px;">
              <h1 style="margin:0 0 6px 0;font-size:22px;line-height:28px;color:#111827;">Thank you! We have received your order.</h1>
              <p style="margin:0;font-size:14px;line-height:22px;color:#4b5563;">Order no. <strong>{{ order_name }}</strong></p>
            </td>
          </tr>

          <!-- Order status -->
          <tr>
            <td style="padding:18px 28px 6px 28px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td width="33%" align="center" style="font-size:12px;font-weight:bold;color:#232832;">
                    <div style="width:54px;height:54px;line-height:54px;border-radius:27px;background:#232832;color:#ffffff;font-size:28px;text-align:center;margin:0 auto 6px auto;">&#10003;</div>
                    Received
                  </td>
                  <td width="33%" align="center" style="font-size:12px;font-weight:bold;color:#9ca3af;">
                    <div style="width:50px;height:50px;line-height:50px;border-radius:27px;border:2px solid #d1d5db;color:#9ca3af;font-size:26px;text-align:center;margin:0 auto 6px auto;">&#10003;</div>
                    Shipped
                  </td>
                  <td width="33%" align="center" style="font-size:12px;font-weight:bold;color:#9ca3af;">
                    <div style="width:50px;height:50px;line-height:50px;border-radius:27px;border:2px solid #d1d5db;color:#9ca3af;font-size:26px;text-align:center;margin:0 auto 6px auto;">&#10003;</div>
                    Delivered
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="padding:14px 28px 4px 28px;font-size:14px;line-height:22px;color:#374151;">
              We are starting to prepare order <strong>{{ order_name }}</strong>. Products with custom printing are made to order — before production we check the print files and will get in touch if anything needs clarifying.
            </td>
          </tr>

          <tr>
            <td align="center" style="padding:16px 28px 8px 28px;">
              <a href="{{ order_status_url }}" style="display:inline-block;background:#111111;color:#ffffff;font-size:14px;font-weight:bold;text-decoration:none;padding:12px 26px;">View order</a>
            </td>
          </tr>

          <!-- Order summary -->
          <tr>
            <td style="padding:18px 0 0 0;">
              <div style="background:#232832;color:#ffffff;font-size:14px;font-weight:bold;padding:10px 28px;">Order summary:</div>
            </td>
          </tr>
          <tr>
            <td style="padding:6px 28px 0 28px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                {% for line in subtotal_line_items %}
                <tr>
                  <td width="72" valign="top" style="padding:12px 12px 12px 0;border-bottom:1px solid #e5e7eb;">
                    {% if line.image %}
                      <img src="{{ line | img_url: 'compact_cropped' }}" alt="{{ line.title | escape }}" width="60" height="60" style="display:block;border:0;width:60px;height:60px;object-fit:cover;">
                    {% endif %}
                  </td>
                  <td valign="top" style="padding:12px 0;border-bottom:1px solid #e5e7eb;font-size:14px;line-height:20px;color:#111827;">
                    {{ line.quantity }}&times; {{ line.title }}
                    {% if line.variant.title != 'Default Title' and line.variant.title != blank %}
                      <br><span style="color:#6b7280;font-size:13px;">{{ line.variant.title }}</span>
                    {% endif %}
                    {% if line.line_level_discount_allocations.size > 0 %}
                      {% for da in line.line_level_discount_allocations %}
                        <br><span style="color:#6b7280;font-size:12px;">Discount {{ da.discount_application.title }} (-{{ da.amount | money }})</span>
                      {% endfor %}
                    {% endif %}
                  </td>
                  <td align="right" valign="top" style="padding:12px 0 12px 12px;border-bottom:1px solid #e5e7eb;font-size:14px;font-weight:bold;color:#111827;white-space:nowrap;">
                    {{ line.final_line_price | money }}
                  </td>
                </tr>
                {% endfor %}
              </table>
            </td>
          </tr>

          <tr>
            <td style="padding:14px 28px 8px 28px;font-size:14px;line-height:26px;color:#111827;">
              {% if total_discounts > 0 %}Discount: <strong>-{{ total_discounts | money }}</strong><br>{% endif %}
              Shipping: <strong>{% if shipping_price > 0 %}{{ shipping_price | money }}{% else %}{{ 0 | money }}{% endif %}</strong><br>
              {% if shipping_method %}Shipping method: <strong>{{ shipping_method.title }}</strong><br>{% elsif requires_shipping == false %}Shipping method: <strong>Local pickup</strong><br>{% endif %}
              {% assign sposob_platby = '' %}
              {% for transaction in transactions %}
                {% if transaction.status == 'success' and transaction.kind == 'sale' or transaction.status == 'success' and transaction.kind == 'capture' %}
                  {% assign sposob_platby = transaction.gateway_display_name %}
                {% endif %}
              {% endfor %}
              {% if sposob_platby != blank %}Payment method: <strong>{{ sposob_platby }}</strong>{% endif %}
            </td>
          </tr>

          <tr>
            <td style="padding:0;">
              <div style="background:#232832;color:#ffffff;font-size:15px;font-weight:bold;padding:11px 28px;">
                Total (incl. VAT): {{ total_price | money }}
              </div>
            </td>
          </tr>

          <!-- Addresses -->
          <tr>
            <td style="padding:18px 28px 4px 28px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  {% if shipping_address %}
                  <td width="50%" valign="top" style="font-size:13px;line-height:20px;color:#374151;padding-right:12px;">
                    <strong style="color:#232832;font-size:14px;">Shipping address:</strong><br>
                    {{ shipping_address | format_address }}
                  </td>
                  {% endif %}
                  {% if billing_address %}
                  <td width="50%" valign="top" style="font-size:13px;line-height:20px;color:#374151;">
                    <strong style="color:#232832;font-size:14px;">Billing address:</strong><br>
                    {{ billing_address | format_address }}
                  </td>
                  {% endif %}
                </tr>
              </table>
            </td>
          </tr>

          <!-- Help -->
          <tr>
            <td style="padding:22px 0 0 0;">
              <div style="background:#c4c7cc;padding:14px 28px;font-size:14px;color:#111827;">
                <strong>Need help? Write to us or call.</strong><br>We are here for you.
              </div>
              <div style="background:#f0f1f3;padding:16px 28px;font-size:13px;line-height:20px;color:#374151;">
                When contacting us about your order, please quote its number <strong>{{ order_name }}</strong>.
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:12px;">
                  <tr>
                    <td align="center" style="padding:0 6px 0 0;">
                      <a href="mailto:{{ shop.email }}" style="display:block;background:#111111;color:#ffffff;font-size:14px;font-weight:bold;text-decoration:none;padding:12px 10px;">{{ shop.email }}</a>
                    </td>
                    {% if shop.phone != blank %}
                    <td align="center" style="padding:0 0 0 6px;">
                      <a href="tel:{{ shop.phone }}" style="display:block;background:#111111;color:#ffffff;font-size:14px;font-weight:bold;text-decoration:none;padding:12px 10px;">{{ shop.phone }}</a>
                    </td>
                    {% endif %}
                  </tr>
                </table>
              </div>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding:16px 28px 22px 28px;font-size:11px;line-height:16px;color:#9ca3af;">
              {{ shop.name }}{% if shop.address.city %} | {{ shop.address.address1 }}, {{ shop.address.zip }} {{ shop.address.city }}{% endif %}
              | <a href="{{ shop.url }}/policies/terms-of-service" style="color:#9ca3af;">Terms of service</a><br>
              This is an automatic order confirmation, not a marketing message.
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
